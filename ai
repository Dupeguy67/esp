-- Fly Feature
local flying = false
local bodyVelocity = nil
local bodyGyro = nil
local flyTask = nil

local function StopFly()
    if flyTask then task.cancel(flyTask); flyTask = nil end
    if bodyVelocity then bodyVelocity:Destroy(); bodyVelocity = nil end
    if bodyGyro then bodyGyro:Destroy(); bodyGyro = nil end
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChild("Humanoid")
        if hum then hum.PlatformStand = false end
    end
    flying = false
end

local function StartFly()
    local char = LocalPlayer.Character
    if not char then return end
    
    local hum = char:FindFirstChild("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end
    
    StopFly()
    flying = true
    
    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.Parent = root
    
    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    bodyGyro.CFrame = root.CFrame
    bodyGyro.Parent = root
    
    hum.PlatformStand = true
    
    flyTask = task.spawn(function()
        while flying and root and root.Parent do
            local moveDir = Vector3.new()
            local cameraCF = Camera.CFrame
            
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                moveDir = moveDir + cameraCF.LookVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                moveDir = moveDir - cameraCF.LookVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                moveDir = moveDir - cameraCF.RightVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                moveDir = moveDir + cameraCF.RightVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                moveDir = moveDir + Vector3.new(0, 1, 0)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
                moveDir = moveDir - Vector3.new(0, 1, 0)
            end
            
            if moveDir.Magnitude > 0 then
                moveDir = moveDir.Unit * Settings.Fly.Speed
            end
            
            if bodyVelocity then
                bodyVelocity.Velocity = moveDir
            end
            if bodyGyro then
                bodyGyro.CFrame = cameraCF
            end
            
            task.wait()
        end
    end)
end

local function ToggleFly()
    if flying then
        StopFly()
    else
        StartFly()
    end
end

-- Invisible Feature
local originalTransparency = {}

local function SetInvisible(enabled)
    local char = LocalPlayer.Character
    if not char then return end
    
    if enabled then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                originalTransparency[part] = part.Transparency
                part.Transparency = 1
                part.Material = Enum.Material.ForceField
            elseif part:IsA("BillboardGui") then
                originalTransparency[part] = part.Enabled
                part.Enabled = false
            end
        end
        local hum = char:FindFirstChild("Humanoid")
        if hum then
            originalTransparency["NameDisplay"] = hum.NameDisplayDistance
            hum.NameDisplayDistance = 0
        end
    else
        for obj, val in pairs(originalTransparency) do
            if obj and obj.Parent then
                if obj:IsA("BasePart") then
                    obj.Transparency = val
                    obj.Material = Enum.Material.Plastic
                elseif obj:IsA("BillboardGui") then
                    obj.Enabled = val
                end
            end
        end
        local hum = char:FindFirstChild("Humanoid")
        if hum and originalTransparency["NameDisplay"] then
            hum.NameDisplayDistance = originalTransparency["NameDisplay"]
        end
        originalTransparency = {}
    end
end

-- Anti-Fling
local lastPositions = {}
local lastVelocities = {}

local function CheckAntiFling(player)
    if not Settings.AntiFling.Enabled then return end
    if player == LocalPlayer then return end
    
    local char = player.Character
    if not char then return end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not root or not hum or hum.Health <= 0 then return end
    
    local currentPos = root.Position
    local currentVel = root.AssemblyLinearVelocity or root.Velocity
    local lastPos = lastPositions[player]
    local lastVel = lastVelocities[player]
    
    if lastPos and lastVel then
        local speed = currentVel.Magnitude
        if speed > Settings.AntiFling.DetectionSpeed then
            root.CFrame = CFrame.new(lastPos)
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            hum.PlatformStand = false
        end
    end
    
    lastPositions[player] = currentPos
    lastVelocities[player] = currentVel
end

-- Fling Feature
local function FlingPlayer(targetPlayer, power)
    if not targetPlayer or targetPlayer == LocalPlayer then return end
    
    local char = targetPlayer.Character
    if not char then return end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    
    if root and hum and hum.Health > 0 then
        local dir = Vector3.new(
            (math.random() - 0.5) * 2,
            1.5,
            (math.random() - 0.5) * 2
        ).Unit
        local vel = dir * power
        root.AssemblyLinearVelocity = vel
        root.Velocity = vel
        
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(1e8, 1e8, 1e8)
        bv.Velocity = vel
        bv.Parent = root
        hum.PlatformStand = true
        
        task.delay(0.5, function()
            if bv then bv:Destroy() end
            if hum then hum.PlatformStand = false end
        end)
    end
end

