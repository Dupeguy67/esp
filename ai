-- // ROLE SYSTEM \\ --
local RoleData = {}
local RoleColors = {
    Murderer = Color3.fromRGB(255, 40, 40),
    Sheriff = Color3.fromRGB(40, 100, 255),
    Innocent = Color3.fromRGB(40, 255, 40)
}

-- // GET PLAYER ROLE \\ --
local function GetRole(Player)
    if Player == LocalPlayer then return nil end
    
    local Character = Player.Character
    if not Character then return "Innocent" end
    
    local HeldTool = Character:FindFirstChildOfClass("Tool")
    if HeldTool then
        local Name = HeldTool.Name:lower()
        if Name:find("knife") or Name:find("dagger") or Name:find("blade") then
            return "Murderer"
        elseif Name:find("gun") or Name:find("pistol") or Name:find("revolver") then
            return "Sheriff"
        end
    end
    
    local Backpack = Player:FindFirstChild("Backpack")
    if Backpack then
        for _, Tool in pairs(Backpack:GetChildren()) do
            if Tool:IsA("Tool") then
                local Name = Tool.Name:lower()
                if Name:find("knife") then return "Murderer"
                elseif Name:find("gun") then return "Sheriff" end
            end
        end
    end
    
    return "Innocent"
end

-- // UPDATE ALL ROLES \\ --
local function UpdateRoles()
    for _, Player in pairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer then
            RoleData[Player] = GetRole(Player)
        end
    end
end

-- // FIND MURDERER \\ --
local function FindMurderer()
    for Player, Role in pairs(RoleData) do
        if Role == "Murderer" then
            local Character = Player.Character
            if Character and Character:FindFirstChild("Humanoid") and Character.Humanoid.Health > 0 then
                return Player
            end
        end
    end
    return nil
end

-- // FIND SHERIFF \\ --
local function FindSheriff()
    for Player, Role in pairs(RoleData) do
        if Role == "Sheriff" then
            local Character = Player.Character
            if Character and Character:FindFirstChild("Humanoid") and Character.Humanoid.Health > 0 then
                return Player
            end
        end
    end
    return nil
end

-- // ESP BILLBOARD SYSTEM \\ --
local ESPObjects = {}

local function CreateESP(Player)
    if Player == LocalPlayer then return end
    
    local Character = Player.Character
    if not Character then return end
    
    local Head = Character:FindFirstChild("Head")
    if not Head then return end
    
    if ESPObjects[Player] then return end
    
    local Billboard = Instance.new("BillboardGui")
    Billboard.Name = "PlayerESP"
    Billboard.Size = UDim2.new(0, 220, 0, 55)
    Billboard.StudsOffset = Vector3.new(0, 2.2, 0)
    Billboard.AlwaysOnTop = true
    Billboard.ResetOnSpawn = false
    Billboard.Parent = Head
    
    local NameLabel = Instance.new("TextLabel")
    NameLabel.Size = UDim2.new(1, 0, 1, 0)
    NameLabel.BackgroundTransparency = 1
    NameLabel.TextScaled = true
    NameLabel.Font = Enum.Font.GothamBold
    NameLabel.TextStrokeTransparency = 0.3
    NameLabel.Parent = Billboard
    
    ESPObjects[Player] = {
        Billboard = Billboard,
        Label = NameLabel
    }
end

local function RemoveESP(Player)
    if ESPObjects[Player] and ESPObjects[Player].Billboard then
        ESPObjects[Player].Billboard:Destroy()
    end
    ESPObjects[Player] = nil
end

local function UpdateESPDisplay()
    for Player, Data in pairs(ESPObjects) do
        local Role = RoleData[Player] or "Innocent"
        local Color = RoleColors[Role]
        local Icon = (Role == "Murderer" and "🔪 ") or (Role == "Sheriff" and "⭐ ") or "👤 "
        
        if Data and Data.Label then
            Data.Label.Text = Icon .. Player.Name .. " [" .. Role .. "]"
            Data.Label.TextColor3 = Color
        end
    end
end

-- // SPEED HACK \\ --
local OriginalSpeed = 16

local function ToggleSpeed(Enable, Value)
    local Character = LocalPlayer.Character
    if not Character then return end
    
    local Humanoid = Character:FindFirstChild("Humanoid")
    if not Humanoid then return end
    
    if Enable then
        OriginalSpeed = Humanoid.WalkSpeed
        Humanoid.WalkSpeed = Value
        Humanoid.JumpPower = Value * 1.4
    else
        Humanoid.WalkSpeed = OriginalSpeed
        Humanoid.JumpPower = 50
    end
end

-- // FLY HACK \\ --
local IsFlying = false
local FlyVelocity = nil

local function DisableFly()
    if FlyVelocity then
        FlyVelocity:Destroy()
        FlyVelocity = nil
    end
    IsFlying = false
    
    local Character = LocalPlayer.Character
    if Character then
        local Humanoid = Character:FindFirstChild("Humanoid")
        if Humanoid then
            Humanoid.PlatformStand = false
        end
    end
end

local function EnableFly()
    local Character = LocalPlayer.Character
    if not Character then return end
    
    local Humanoid = Character:FindFirstChild("Humanoid")
    local RootPart = Character:FindFirstChild("HumanoidRootPart")
    
    if not Humanoid or not RootPart then return end
    
    DisableFly()
    IsFlying = true
    
    FlyVelocity = Instance.new("BodyVelocity")
    FlyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    FlyVelocity.Velocity = Vector3.new(0, 0, 0)
    FlyVelocity.Parent = RootPart
    Humanoid.PlatformStand = true
    
    task.spawn(function()
        while IsFlying and RootPart and RootPart.Parent do
            local Movement = Vector3.new()
            local CameraCF = Camera.CFrame
            
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then Movement = Movement + CameraCF.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then Movement = Movement - CameraCF.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then Movement = Movement - CameraCF.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then Movement = Movement + CameraCF.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then Movement = Movement + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then Movement = Movement - Vector3.new(0, 1, 0) end
            
            if Movement.Magnitude > 0 then
                Movement = Movement.Unit * 45
            end
            
            if FlyVelocity then
                FlyVelocity.Velocity = Movement
            end
            task.wait()
        end
    end)
end

-- // INVISIBLE MODE \\ --
local function SetInvisibleMode(Enable)
    local Character = LocalPlayer.Character
    if not Character then return end
    
    for _, Part in pairs(Character:GetDescendants()) do
        if Part:IsA("BasePart") then
            Part.Transparency = Enable and 1 or 0
            if Enable then
                Part.Material = Enum.Material.ForceField
            end
        elseif Part:IsA("BillboardGui") then
            Part.Enabled = not Enable
        end
    end
    
    local Humanoid = Character:FindFirstChild("Humanoid")
    if Humanoid then
        Humanoid.NameDisplayDistance = Enable and 0 or 100
    end
end

-- // AUTO PICKUP WEAPON \\ --
local function PickupWeapons()
    if not Config.AutoPickup then return end
    
    local Character = LocalPlayer.Character
    if not Character then return end
    
    local RootPart = Character:FindFirstChild("HumanoidRootPart")
    if not RootPart then return end
    
    local CurrentPosition = RootPart.Position
    
    for _, Object in pairs(Workspace:GetDescendants()) do
        if Object:IsA("Tool") and Object.Parent ~= Character and Object.Parent ~= LocalPlayer.Backpack then
            local Name = Object.Name:lower()
            local IsWeapon = Name:find("gun") or Name:find("pistol") or Name:find("revolver") or Name:find("sheriff")
            
            if IsWeapon then
                local Distance = (CurrentPosition - Object.Position).Magnitude
                if Distance <= 18 then
                    local Prompt = Object:FindFirstChildOfClass("ProximityPrompt")
                    if Prompt then
                        Prompt:Hold()
                        task.wait(0.05)
                        Prompt:Release()
                    end
                    task.wait(0.25)
                end
            end
        end
    end
end

-- // AIMBOT \\ --
local function RunAimbot()
    if not Config.Aimbot then return end
    
    local Target = FindMurderer()
    if not Target then return end
    
    local Character = Target.Character
    if not Character then return end
    
    local AimPart = Character:FindFirstChild("Head") or Character:FindFirstChild("HumanoidRootPart")
    if not AimPart then return end
    
    local TargetPosition = AimPart.Position
    local TargetDirection = (TargetPosition - Camera.CFrame.Position).Unit
    local TargetCFrame = CFrame.lookAt(Camera.CFrame.Position, Camera.CFrame.Position + TargetDirection)
    
    Camera.CFrame = Camera.CFrame:Lerp(TargetCFrame, 0.2)
end

-- // FPS COUNTER \\ --
local FrameCount = 0
local LastTime = tick()
local CurrentFPS = 60

local function UpdateFPS()
    FrameCount = FrameCount + 1
    local Now = tick()
    if Now - LastTime >= 1 then
        CurrentFPS = FrameCount
        FrameCount = 0
        LastTime = Now
    end
end

