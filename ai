-- Role Data
local RoleData = {}
local RoleColors = {
    Murderer = Color3.fromRGB(255, 50, 50),
    Sheriff = Color3.fromRGB(50, 100, 255),
    Innocent = Color3.fromRGB(50, 255, 50)
}

-- Get Player Role
local function GetRole(Player)
    if Player == LocalPlayer then return nil end
    local Character = Player.Character
    if not Character then return "Innocent" end
    
    local Tool = Character:FindFirstChildOfClass("Tool")
    if Tool then
        local Name = Tool.Name:lower()
        if Name:find("knife") or Name:find("dagger") or Name:find("blade") then
            return "Murderer"
        elseif Name:find("gun") or Name:find("pistol") or Name:find("revolver") then
            return "Sheriff"
        end
    end
    return "Innocent"
end

-- Update Roles
local function UpdateRoles()
    for _, Player in pairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer then
            RoleData[Player] = GetRole(Player)
        end
    end
end

-- Find Murderer
local function GetMurderer()
    for Player, Role in pairs(RoleData) do
        if Role == "Murderer" then
            local Char = Player.Character
            if Char and Char:FindFirstChild("Humanoid") and Char.Humanoid.Health > 0 then
                return Player
            end
        end
    end
    return nil
end

-- ESP Billboard System
local ESPObjects = {}

local function CreateESP(Player)
    if Player == LocalPlayer then return end
    local Character = Player.Character
    if not Character then return end
    local Head = Character:FindFirstChild("Head")
    if not Head then return end
    if ESPObjects[Player] then return end
    
    local Billboard = Instance.new("BillboardGui")
    Billboard.Name = "ESP"
    Billboard.Size = UDim2.new(0, 200, 0, 45)
    Billboard.StudsOffset = Vector3.new(0, 2.2, 0)
    Billboard.AlwaysOnTop = true
    Billboard.ResetOnSpawn = false
    Billboard.Parent = Head
    
    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, 0, 1, 0)
    Label.BackgroundTransparency = 1
    Label.TextScaled = true
    Label.Font = Enum.Font.GothamBold
    Label.TextStrokeTransparency = 0.3
    Label.Parent = Billboard
    
    ESPObjects[Player] = {Billboard = Billboard, Label = Label}
end

local function RemoveESP(Player)
    if ESPObjects[Player] and ESPObjects[Player].Billboard then
        ESPObjects[Player].Billboard:Destroy()
    end
    ESPObjects[Player] = nil
end

local function UpdateESP()
    for Player, Data in pairs(ESPObjects) do
        local Role = RoleData[Player] or "Innocent"
        local Color = RoleColors[Role]
        local Icon = (Role == "Murderer" and "🔪 ") or (Role == "Sheriff" and "⭐ ") or "👤 "
        if Data.Label then
            Data.Label.Text = Icon .. Player.Name .. " [" .. Role .. "]"
            Data.Label.TextColor3 = Color
        end
        if Data.Billboard then
            Data.Billboard.Enabled = Settings.ESP
        end
    end
end

-- Speed Hack
local OriginalSpeed = 16

local function SetSpeed(Enable, Value)
    local Character = LocalPlayer.Character
    if not Character then return end
    local Humanoid = Character:FindFirstChild("Humanoid")
    if not Humanoid then return end
    if Enable then
        OriginalSpeed = Humanoid.WalkSpeed
        Humanoid.WalkSpeed = Value
        Humanoid.JumpPower = Value * 1.4
    else
        Humanoid.WalkSpeed = OriginalSpeed
        Humanoid.JumpPower = 50
    end
end

-- Fly Hack
local IsFlying = false
local FlyVelocity = nil

local function StopFly()
    if FlyVelocity then FlyVelocity:Destroy() end
    FlyVelocity = nil
    IsFlying = false
    local Character = LocalPlayer.Character
    if Character then
        local Humanoid = Character:FindFirstChild("Humanoid")
        if Humanoid then Humanoid.PlatformStand = false end
    end
end

local function StartFly()
    local Character = LocalPlayer.Character
    if not Character then return end
    local Humanoid = Character:FindFirstChild("Humanoid")
    local RootPart = Character:FindFirstChild("HumanoidRootPart")
    if not Humanoid or not RootPart then return end
    
    StopFly()
    IsFlying = true
    
    FlyVelocity = Instance.new("BodyVelocity")
    FlyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    FlyVelocity.Velocity = Vector3.new(0, 0, 0)
    FlyVelocity.Parent = RootPart
    Humanoid.PlatformStand = true
    
    task.spawn(function()
        while IsFlying and RootPart and RootPart.Parent do
            local Movement = Vector3.new()
            local CameraCF = Camera.CFrame
            
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then Movement = Movement + CameraCF.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then Movement = Movement - CameraCF.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then Movement = Movement - CameraCF.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then Movement = Movement + CameraCF.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then Movement = Movement + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then Movement = Movement - Vector3.new(0, 1, 0) end
            
            if Movement.Magnitude > 0 then
                Movement = Movement.Unit * 45
            end
            
            if FlyVelocity then FlyVelocity.Velocity = Movement end
            task.wait()
        end
    end)
end

-- Invisible Mode
local function SetInvisible(Enable)
    local Character = LocalPlayer.Character
    if not Character then return end
    
    for _, Part in pairs(Character:GetDescendants()) do
        if Part:IsA("BasePart") then
            Part.Transparency = Enable and 1 or 0
            if Enable then Part.Material = Enum.Material.ForceField end
        elseif Part:IsA("BillboardGui") then
            Part.Enabled = not Enable
        end
    end
    
    local Humanoid = Character:FindFirstChild("Humanoid")
    if Humanoid then
        Humanoid.NameDisplayDistance = Enable and 0 or 100
    end
end

-- Auto Pickup
local function AutoPickup()
    if not Settings.AutoPickup then return end
    
    local Character = LocalPlayer.Character
    if not Character then return end
    local RootPart = Character:FindFirstChild("HumanoidRootPart")
    if not RootPart then return end
    
    for _, Object in pairs(Workspace:GetDescendants()) do
        if Object:IsA("Tool") and Object.Parent ~= Character and Object.Parent ~= LocalPlayer.Backpack then
            local Name = Object.Name:lower()
            local IsWeapon = Name:find("gun") or Name:find("pistol") or Name:find("revolver") or Name:find("sheriff")
            
            if IsWeapon then
                local Distance = (RootPart.Position - Object.Position).Magnitude
                if Distance <= 18 then
                    local Prompt = Object:FindFirstChildOfClass("ProximityPrompt")
                    if Prompt then
                        Prompt:Hold()
                        task.wait(0.05)
                        Prompt:Release()
                    end
                    task.wait(0.25)
                end
            end
        end
    end
end

-- Aimbot
local function RunAimbot()
    if not Settings.Aimbot then return end
    
    local Target = GetMurderer()
    if not Target then return end
    
    local Character = Target.Character
    if not Character then return end
    
    local AimPart = Character:FindFirstChild("Head") or Character:FindFirstChild("HumanoidRootPart")
    if not AimPart then return end
    
    local TargetPos = AimPart.Position
    local TargetDir = (TargetPos - Camera.CFrame.Position).Unit
    local TargetCFrame = CFrame.lookAt(Camera.CFrame.Position, Camera.CFrame.Position + TargetDir)
    
    Camera.CFrame = Camera.CFrame:Lerp(TargetCFrame, 0.2)
end

-- FPS Counter
local FrameCount = 0
local LastTime = tick()
local CurrentFPS = 60

local function UpdateFPS()
    FrameCount = FrameCount + 1
    local Now = tick()
    if Now - LastTime >= 1 then
        CurrentFPS = FrameCount
        FrameCount = 0
        LastTime = Now
    end
end

