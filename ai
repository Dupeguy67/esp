--[[
    Roblox Murder Mystery ESP + Role Detection
    Roles: MURDERER (Kirmizi), SHERIFF (Mavi), INNOCENT (Yesil)
    Local script for supported executors
--]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
