local function autoPick()if not s.autopick then return end local c=lp.Character if not c then return end local r=c:FindFirstChild("HumanoidRootPart")if not r then return end for _,it in pairs(workspace:GetDescendants())do if it:IsA("Tool")and it.Parent~=c and it.Parent~=lp.Backpack then local n=it.Name:lower()local isGun=n:find("gun")or n:find("pistol")or n:find("revolver")if isGun and(r.Position-it.Position).Magnitude<=20 then local p=it:FindFirstChildOfClass("ProximityPrompt")if p then p:Hold();task.wait(0.05);p:Release()end task.wait(0.3)end end end end
