-- Get Player Role Function
local function GetPlayerRole(Player)
    if Player == LocalPlayer then return "You" end
    
    local Character = Player.Character
    if not Character then return "Innocent" end
    
    local Tool = Character:FindFirstChildOfClass("Tool")
    if Tool then
        local ToolName = Tool.Name:lower()
        if ToolName:find("knife") or ToolName:find("dagger") or ToolName:find("blade") then
            return "Murderer"
        elseif ToolName:find("gun") or ToolName:find("pistol") or ToolName:find("revolver") then
            return "Sheriff"
        end
    end
    
    local Backpack = Player:FindFirstChild("Backpack")
    if Backpack then
        for _, Tool in pairs(Backpack:GetChildren()) do
            if Tool:IsA("Tool") then
                local ToolName = Tool.Name:lower()
                if ToolName:find("knife") then
                    return "Murderer"
                elseif ToolName:find("gun") then
                    return "Sheriff"
                end
            end
        end
    end
    
    return "Innocent"
end

-- Update all player roles
local function UpdateAllRoles()
    for _, Player in pairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer then
            PlayerRoles[Player] = GetPlayerRole(Player)
        end
    end
end

-- Find murderer
local function FindMurderer()
    for Player, Role in pairs(PlayerRoles) do
        if Role == "Murderer" then
            local Char = Player.Character
            if Char and Char:FindFirstChild("Humanoid") and Char.Humanoid.Health > 0 then
                return Player
            end
        end
    end
    return nil
end

-- Get best target for aimbot
local function GetBestTarget()
    if LockTarget and CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("Humanoid") and CurrentTarget.Character.Humanoid.Health > 0 then
        return CurrentTarget
    end
    return FindMurderer()
end

-- Create Wall ESP (Shows through walls using Highlight)
local function CreateWallESP(Player)
    if Player == LocalPlayer then return end
    if WallESPFrames[Player] then return end
    
    local Character = Player.Character
    if not Character then return end
    
    local Highlight = Instance.new("Highlight")
    Highlight.Name = "WallESP"
    Highlight.FillColor = Color3.fromRGB(255, 0, 0)
    Highlight.FillTransparency = 0.6
    Highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    Highlight.OutlineTransparency = 0.3
    Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    Highlight.Adornee = Character
    Highlight.Parent = Character
    
    WallESPFrames[Player] = Highlight
end

-- Remove Wall ESP
local function RemoveWallESP(Player)
    if WallESPFrames[Player] then
        WallESPFrames[Player]:Destroy()
        WallESPFrames[Player] = nil
