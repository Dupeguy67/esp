-- Remove Billboard ESP
local function RemoveBillboardESP(Player)
    if ESPInstances[Player] then
        if ESPInstances[Player].Billboard then
            ESPInstances[Player].Billboard:Destroy()
        end
        ESPInstances[Player] = nil
    end
end

-- Remove all ESP
local function RemoveAllESP(Player)
    RemoveBillboardESP(Player)
    RemoveWallESP(Player)
end

-- Rebuild all ESP
local function RebuildAllESP()
    if isRebuildingESP then return end
    isRebuildingESP = true
    
    for Player, _ in pairs(ESPInstances) do
        RemoveBillboardESP(Player)
    end
    for Player, _ in pairs(WallESPFrames) do
        RemoveWallESP(Player)
    end
    
    ESPInstances = {}
    WallESPFrames = {}
    
    task.wait(0.5)
    
    for _, Player in pairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer then
            task.wait(0.05)
            CreateWallESP(Player)
            CreateBillboardESP(Player)
        end
    end
    
    UpdateAllRoles()
    UpdateESPDisplay()
    
    isRebuildingESP = false
end

-- Update ESP Display
local function UpdateESPDisplay()
    for Player, Data in pairs(ESPInstances) do
        local Role = PlayerRoles[Player] or "Innocent"
        local RoleColor = nil
        local RoleText = ""
        local Icon = ""
        
        if Role == "Murderer" then
            RoleColor = Color3.fromRGB(255, 40, 40)
            RoleText = "🔪 MURDERER"
            Icon = "🔪 "
        elseif Role == "Sheriff" then
            RoleColor = Color3.fromRGB(40, 120, 255)
            RoleText = "⭐ SHERIFF"
            Icon = "⭐ "
        else
            RoleColor = Color3.fromRGB(40, 255, 40)
            RoleText = "👤 INNOCENT"
            Icon = "👤 "
        end
        
        if Data.ColorBar then
            Data.ColorBar.BackgroundColor3 = RoleColor
        end
        
        if Data.NameLabel then
            Data.NameLabel.Text = Icon .. Player.Name
            Data.NameLabel.TextColor3 = RoleColor
        end
        
        if Data.RoleLabel then
            Data.RoleLabel.Text = RoleText
            Data.RoleLabel.TextColor3 = RoleColor
        end
        
        if Data.DistanceLabel and Player.Character then
            local RootPart = Player.Character:FindFirstChild("HumanoidRootPart")
            if RootPart and LocalPlayer.Character then
                local LocalRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if LocalRoot then
                    local Distance = (LocalRoot.Position - RootPart.Position).Magnitude
                    Data.DistanceLabel.Text = math.floor(Distance) .. "m"
                end
            end
        end
        
        if Data.Billboard then
            Data.Billboard.Enabled = Settings.ESP
        end
    end
    
    for Player, Highlight in pairs(WallESPFrames) do
        local Role = PlayerRoles[Player] or "Innocent"
        local Color = Role == "Murderer" and Color3.fromRGB(255, 40, 40) or (Role == "Sheriff" and Color3.fromRGB(40, 120, 255) or Color3.fromRGB(40, 255, 40))
        Highlight.FillColor = Color
        Highlight.Enabled = Settings.ESP
    end
end

-- Speed Hack
local function SetSpeed(Enabled, Value)
    local Character = LocalPlayer.Character
    if not Character then return end
    local Humanoid = Character:FindFirstChild("Humanoid")
    if not Humanoid then return end
    
    if Enabled then
        OriginalWalkSpeed = Humanoid.WalkSpeed
        OriginalJumpPower = Humanoid.JumpPower
        Humanoid.WalkSpeed = Value
        Humanoid.JumpPower = Value * 1.4
    else
        Humanoid.WalkSpeed = OriginalWalkSpeed
        Humanoid.JumpPower = OriginalJumpPower
    end
end

-- Invisible Mode
local OriginalTransparency = {}

local function SetInvisible(Enabled)
    local Character = LocalPlayer.Character
    if not Character then return end
    
    if Enabled then
        for _, Part in pairs(Character:GetDescendants()) do
            if Part:IsA("BasePart") then
                OriginalTransparency[Part] = Part.Transparency
                Part.Transparency = 1
                Part.Material = Enum.Material.ForceField
            elseif Part:IsA("BillboardGui") then
                OriginalTransparency[Part] = Part.Enabled
                Part.Enabled = false
            end
        end
        local Humanoid = Character:FindFirstChild("Humanoid")
        if Humanoid then
            OriginalTransparency["NameDisplay"] = Humanoid.NameDisplayDistance
            Humanoid.NameDisplayDistance = 0
        end
    else
        for Object, Value in pairs(OriginalTransparency) do
            if Object and Object.Parent then
                if Object:IsA("BasePart") then
                    Object.Transparency = Value
                    Object.Material = Enum.Material.Plastic
                elseif Object:IsA("BillboardGui") then
                    Object.Enabled = Value
                end
            end
        end
        local Humanoid = Character:FindFirstChild("Humanoid")
        if Humanoid and OriginalTransparency["NameDisplay"] then
            Humanoid.NameDisplayDistance = OriginalTransparency["NameDisplay"]
        end
        OriginalTransparency = {}
    end
end

-- Auto Pickup
local function AutoPickupWeapons()
    if not Settings.AutoPickup then return end
    
    local Character = LocalPlayer.Character
    if not Character then return end
    
    local HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")
    if not HumanoidRootPart then return end
    
    local CharacterPosition = HumanoidRootPart.Position
    
    for _, Object in pairs(Workspace:GetDescendants()) do
        if Object:IsA("Tool") and Object.Parent ~= Character and Object.Parent ~= LocalPlayer.Backpack then
            local ObjectName = Object.Name:lower()
            local IsGun = ObjectName:find("gun") or ObjectName:find("pistol") or ObjectName:find("revolver") or ObjectName:find("sheriff") or Object:FindFirstChild("Handle")
            
            if IsGun then
                local Distance = (CharacterPosition - Object.Position).Magnitude
                if Distance <= 25 then
                    local Prompt = Object:FindFirstChildOfClass("ProximityPrompt")
                    if Prompt then
                        pcall(function()
                            fireproximityprompt(Prompt)
                            Prompt:Hold()
                            task.wait(0.05)
                            Prompt:Release()
                        end)
                    end
                    task.wait(0.15)
                end
            end
        end
    end
end

-- Shoot Murderer
local function ShootMurderer()
    local Target = GetBestTarget()
    if not Target then return end
    
    local Character = Target.Character
    if not Character then return end
    
    local AimPart = Character:FindFirstChild("Head") or Character:FindFirstChild("HumanoidRootPart")
    if not AimPart then return end
    
    local TargetPosition = AimPart.Position
    local CurrentCFrame = Camera.CFrame
    local Direction = (TargetPosition - CurrentCFrame.Position).Unit
    local TargetCFrame = CFrame.lookAt(CurrentCFrame.Position, CurrentCFrame.Position + Direction)
    Camera.CFrame = TargetCFrame
    
    task.wait(0.05)
    
    pcall(function()
        local VirtualUser = game:GetService("VirtualUser")
        VirtualUser:ClickButton1(Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2))
    end)
    
    pcall(function()
        local Mouse = LocalPlayer:GetMouse()
        Mouse1Click()
    end)
end

-- Continuous Aimbot
local function RunAimbot()
    if not Settings.Aimbot then return end
    
    local Target = GetBestTarget()
    if not Target then return end
    
    local Character = Target.Character
    if not Character then return end
    
    local AimPart = Character:FindFirstChild("Head") or Character:FindFirstChild("HumanoidRootPart")
    if not AimPart then return end
    
    local TargetPosition = AimPart.Position
    local CurrentCFrame = Camera.CFrame
    local Direction = (TargetPosition - CurrentCFrame.Position).Unit
    local TargetCFrame = CFrame.lookAt(CurrentCFrame.Position, CurrentCFrame.Position + Direction)
    
    Camera.CFrame = CurrentCFrame:Lerp(TargetCFrame, 0.2)
end

