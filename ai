-- Drag System (Mobile & PC)
local Dragging = false
local DragStartPos, StartFramePos

TopBar.InputBegan:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.Touch or Input.UserInputType == Enum.UserInputType.MouseButton1 then
        Dragging = true
        DragStartPos = Input.Position
        StartFramePos = MainContainer.Position
    end
end)

TopBar.InputEnded:Connect(function()
    Dragging = false
end)

UserInputService.InputChanged:Connect(function(Input)
    if Dragging and (Input.UserInputType == Enum.UserInputType.Touch or Input.UserInputType == Enum.UserInputType.MouseMovement) then
        local Delta = Input.Position - DragStartPos
        MainContainer.Position = UDim2.new(StartFramePos.X.Scale, StartFramePos.X.Offset + Delta.X, StartFramePos.Y.Scale, StartFramePos.Y.Offset + Delta.Y)
    end
end)

-- Keybinds
UserInputService.InputBegan:Connect(function(Input, GameProcessed)
    if GameProcessed then return end
    
    if Input.KeyCode == Enum.KeyCode.Insert then
        local newState = not Settings.ESP
        Settings.ESP = newState
        ESPToggle.BackgroundColor3 = newState and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(60, 60, 80)
        ESPToggle.Text = newState and "ON" or "OFF"
        UpdateESPDisplay()
    elseif Input.KeyCode == Enum.KeyCode.Home then
        local newState = not Settings.Aimbot
        Settings.Aimbot = newState
        AimToggle.BackgroundColor3 = newState and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(60, 60, 80)
        AimToggle.Text = newState and "ON" or "OFF"
    elseif Input.KeyCode == Enum.KeyCode.Delete then
        local newState = not Settings.Invisible
        Settings.Invisible = newState
        InvToggle.BackgroundColor3 = newState and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(60, 60, 80)
        InvToggle.Text = newState and "ON" or "OFF"
        SetInvisible(newState)
    elseif Input.KeyCode == Enum.KeyCode.End then
        ShootMurderer()
    elseif Input.KeyCode == Enum.KeyCode.PageUp then
        local newState = not Settings.AutoShoot
        Settings.AutoShoot = newState
        AutoShootToggle.BackgroundColor3 = newState and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(60, 60, 80)
        AutoShootToggle.Text = newState and "ON" or "OFF"
    elseif Input.KeyCode == Enum.KeyCode.PageDown then
        local newState = not Settings.LockTarget
        Settings.LockTarget = newState
        LockToggle.BackgroundColor3 = newState and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(60, 60, 80)
        LockToggle.Text = newState and "ON" or "OFF"
        if newState then
            CurrentTarget = FindMurderer()
        else
            CurrentTarget = nil
        end
    end
end)

-- FPS Counter
local FrameCounter = 0
local LastTime = tick()
local CurrentFPS = 60

RunService.RenderStepped:Connect(function()
    FrameCounter = FrameCounter + 1
    local Now = tick()
    if Now - LastTime >= 1 then
        CurrentFPS = FrameCounter
        FrameCounter = 0
        LastTime = Now
        
        local FPSColor = CurrentFPS >= 50 and Color3.fromRGB(0, 255, 0) or (CurrentFPS >= 30 and Color3.fromRGB(255, 200, 0) or Color3.fromRGB(255, 0, 0))
        FPSLabel.Text = "FPS: " .. CurrentFPS
        FPSLabel.TextColor3 = FPSColor
    end
end)

