-- ==================== ROLE DETECTION ====================
local PlayerRoles = {}
local WeaponCache = {}

local function GetPlayerRole(Player)
    if Player == LocalPlayer then return nil end
    
    local Character = Player.Character
    if not Character then return "Innocent" end
    
    local CurrentTool = Character:FindFirstChildOfClass("Tool")
    if CurrentTool then
        local ToolName = CurrentTool.Name:lower()
        if ToolName:find("knife") or ToolName:find("dagger") or ToolName:find("blade") or ToolName:find("murder") then
            return "Murderer"
        elseif ToolName:find("gun") or ToolName:find("pistol") or ToolName:find("revolver") or ToolName:find("sheriff") then
            return "Sheriff"
        end
    end
    
    local Backpack = Player:FindFirstChild("Backpack")
    if Backpack then
        for _, tool in ipairs(Backpack:GetChildren()) do
            if tool:IsA("Tool") then
                local ToolName = tool.Name:lower()
                if ToolName:find("knife") or ToolName:find("dagger") then
                    return "Murderer"
                elseif ToolName:find("gun") or ToolName:find("pistol") then
                    return "Sheriff"
                end
            end
        end
    end
    
    local Humanoid = Character:FindFirstChild("Humanoid")
    if Humanoid then
        local nameDisplay = Humanoid:FindFirstChild("NameDisplay")
        if nameDisplay and nameDisplay.NameColor3 then
            if nameDisplay.NameColor3 == Color3.new(1, 0, 0) then
                return "Murderer"
            elseif nameDisplay.NameColor3 == Color3.new(0, 0.4, 1) then
                return "Sheriff"
            end
        end
    end
    
    return "Innocent"
end

local function UpdateAllRoles()
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer then
            PlayerRoles[Player] = GetPlayerRole(Player)
        end
    end
end

local function GetMurderer()
    for Player, role in pairs(PlayerRoles) do
        if role == "Murderer" then
            local Char = Player.Character
            if Char and Char:FindFirstChild("Humanoid") and Char.Humanoid.Health > 0 then
                return Player
            end
        end
    end
    return nil
end

local function GetSheriff()
    for Player, role in pairs(PlayerRoles) do
        if role == "Sheriff" then
            local Char = Player.Character
            if Char and Char:FindFirstChild("Humanoid") and Char.Humanoid.Health > 0 then
                return Player
            end
        end
    end
    return nil
end

-- ==================== FPS MONITOR ====================
local FPSData = {
    Current = 60,
    FrameCount = 0,
    LastTime = tick(),
    Min = 60,
    Max = 60,
    Average = 60,
    AverageSum = 0,
    AverageCount = 0
}

local function UpdateFPS()
    FPSData.FrameCount = FPSData.FrameCount + 1
    local CurrentTime = tick()
    if CurrentTime - FPSData.LastTime >= 1 then
        FPSData.Current = FPSData.FrameCount
        FPSData.Min = math.min(FPSData.Min, FPSData.Current)
        FPSData.Max = math.max(FPSData.Max, FPSData.Current)
        FPSData.AverageSum = FPSData.AverageSum + FPSData.Current
        FPSData.AverageCount = FPSData.AverageCount + 1
        FPSData.Average = math.floor(FPSData.AverageSum / FPSData.AverageCount)
        FPSData.FrameCount = 0
        FPSData.LastTime = CurrentTime
    end
end

-- ==================== INVISIBLE FEATURE ====================
local OriginalProperties = {}

local function SetInvisible(Enable)
    local Character = LocalPlayer.Character
    if not Character then return end
    
    if Enable then
        for _, descendant in ipairs(Character:GetDescendants()) do
            if descendant:IsA("BasePart") then
                if not OriginalProperties[descendant] then
                    OriginalProperties[descendant] = {
                        Transparency = descendant.Transparency,
                        Material = descendant.Material,
                        Visible = descendant.Visible
                    }
                end
                descendant.Transparency = 1
                descendant.Material = Enum.Material.ForceField
                descendant.Visible = true
            elseif descendant:IsA("BillboardGui") or descendant:IsA("Decal") then
                if not OriginalProperties[descendant] then
                    OriginalProperties[descendant] = { Enabled = descendant.Enabled }
                end
                descendant.Enabled = false
            end
        end
        local Humanoid = Character:FindFirstChild("Humanoid")
        if Humanoid then
            OriginalProperties["HumanoidNameDisplay"] = Humanoid.NameDisplayDistance
            Humanoid.NameDisplayDistance = 0
        end
    else
        for obj, props in pairs(OriginalProperties) do
            if obj and obj.Parent then
                if obj:IsA("BasePart") then
                    obj.Transparency = props.Transparency
                    obj.Material = props.Material
                elseif obj:IsA("BillboardGui") or obj:IsA("Decal") then
                    obj.Enabled = props.Enabled
                end
            end
        end
        local Humanoid = Character:FindFirstChild("Humanoid")
        if Humanoid and OriginalProperties["HumanoidNameDisplay"] then
            Humanoid.NameDisplayDistance = OriginalProperties["HumanoidNameDisplay"]
        end
        OriginalProperties = {}
    end
end

-- ==================== AUTO PICKUP GUN ====================
local function AutoPickupGun()
    if not Settings.AutoPickup.Enabled then return end
    
    local Character = LocalPlayer.Character
    if not Character then return end
    
    local RootPart = Character:FindFirstChild("HumanoidRootPart")
    if not RootPart then return end
    
    local CharPos = RootPart.Position
    
    for _, item in ipairs(Workspace:GetDescendants()) do
        if item:IsA("Tool") and item.Parent ~= Character and item.Parent ~= LocalPlayer.Backpack then
            local isWeapon = false
            local itemName = item.Name:lower()
            
            if itemName:find("gun") or itemName:find("pistol") or itemName:find("revolver") then
                isWeapon = true
            elseif itemName:find("sheriff") or itemName:find("weapon") then
                isWeapon = true
            elseif item:FindFirstChild("Handle") or item:FindFirstChild("Grip") then
                isWeapon = true
            end
            
            if isWeapon then
                local itemPos = item.Position
                local distance = (CharPos - itemPos).Magnitude
                
                if distance <= Settings.AutoPickup.Range then
                    local prompt = item:FindFirstChildOfClass("ProximityPrompt")
                    local detector = item:FindFirstChildOfClass("ClickDetector")
                    
                    if prompt then
                        prompt:Hold()
                        task.wait(0.05)
                        prompt:Release()
                    elseif detector then
                        detector:Click()
                    else
                        local remote = ReplicatedStorage:FindFirstChild("Pickup") or 
                                      ReplicatedStorage:FindFirstChild("Equip") or
                                      ReplicatedStorage:FindFirstChild("Grab")
                        if remote then
                            remote:FireServer(item)
                        end
                    end
                    task.wait(Settings.AutoPickup.PickupDelay)
                end
            end
        end
    end
end

-- ==================== ANTI-FLING ====================
local PlayerVelocities = {}
local LastPositions = {}
local LastCheckTime = {}

local function CheckAntiFling(Player)
    if not Settings.AntiFling.Enabled then return false end
    if Player == LocalPlayer then return false end
    
    local Character = Player.Character
    if not Character then return false end
    
    local RootPart = Character:FindFirstChild("HumanoidRootPart")
    local Humanoid = Character:FindFirstChild("Humanoid")
    
    if not RootPart or not Humanoid or Humanoid.Health <= 0 then return false end
    
    local CurrentPos = RootPart.Position
    local CurrentVel = RootPart.AssemblyLinearVelocity or RootPart.Velocity
    local CurrentTime = tick()
    local LastPos = LastPositions[Player]
    local LastVel = PlayerVelocities[Player]
    local LastTime = LastCheckTime[Player] or CurrentTime
    
    if LastPos and LastVel then
        local deltaTime = CurrentTime - LastTime
        local speed = CurrentVel.Magnitude
        local distanceMoved = (CurrentPos - LastPos).Magnitude
        
        if speed > Settings.AntiFling.DetectionSpeed or distanceMoved > Settings.AntiFling.DetectionDistance then
            if Settings.AntiFling.TeleportBack and LastPos.Y > 0 then
                RootPart.CFrame = CFrame.new(LastPos)
                RootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                RootPart.Velocity = Vector3.new(0, 0, 0)
                Humanoid.PlatformStand = false
                return true
            end
        end
    end
    
    LastPositions[Player] = CurrentPos
    PlayerVelocities[Player] = CurrentVel
    LastCheckTime[Player] = CurrentTime
    return false
end

-- ==================== FLING FEATURE ====================
local function FlingPlayer(TargetPlayer, Power)
    if not TargetPlayer or TargetPlayer == LocalPlayer then return end
    
    local Character = TargetPlayer.Character
    if not Character then return end
    
    local RootPart = Character:FindFirstChild("HumanoidRootPart")
    local Humanoid = Character:FindFirstChild("Humanoid")
    
    if RootPart and Humanoid and Humanoid.Health > 0 then
        local direction
        if Settings.Fling.RandomDirection then
            direction = Vector3.new(
                (math.random() - 0.5) * 2,
                1.2 + math.random() * 0.6,
                (math.random() - 0.5) * 2
            ).Unit
        else
            direction = Vector3.new(0, 1.5, 0.5).Unit
        end
        
        local velocity = direction * Power
        RootPart.AssemblyLinearVelocity = velocity
        RootPart.Velocity = velocity
        
        local bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.MaxForce = Vector3.new(1e8, 1e8, 1e8)
        bodyVelocity.Velocity = velocity
        bodyVelocity.P = 1e5
        bodyVelocity.Parent = RootPart
        
        Humanoid.PlatformStand = true
        
        task.delay(0.5, function()
            if bodyVelocity then bodyVelocity:Destroy() end
            if Humanoid then Humanoid.PlatformStand = false end
        end)
    end
end

-- ==================== AIMBOT ====================
local function GetAimPosition(TargetPlayer)
    if not TargetPlayer then return nil end
    local Character = TargetPlayer.Character
    if not Character then return nil end
    
    local aimPart = Character:FindFirstChild(Settings.Aimbot.AimPart)
    if not aimPart then
        aimPart = Character:FindFirstChild("HumanoidRootPart")
    end
    if not aimPart then return nil end
    
    return aimPart.Position
end

local function IsInFOV(HeadPos)
    if not Settings.Aimbot.FOV or Settings.Aimbot.FOV >= 360 then return true end
    
    local cameraPos = Camera.CFrame.Position
    local directionToTarget = (HeadPos - cameraPos).Unit
    local cameraDirection = Camera.CFrame.LookVector
    
    local angle = math.deg(math.acos(directionToTarget:Dot(cameraDirection)))
    return angle <= (Settings.Aimbot.FOV / 2)
end

local function DoAimbot()
    if not Settings.Aimbot.Enabled then return end
    
    local target
    if Settings.Aimbot.OnlyOnMurderer then
        target = GetMurderer()
    else
        for Player, role in pairs(PlayerRoles) do
            if role == "Murderer" then
                target = Player
                break
            end
        end
    end
    
    if not target then return end
    
    local targetPos = GetAimPosition(target)
    if not targetPos then return end
    
    if not IsInFOV(targetPos) then return end
    
    local screenPos, onScreen = Camera:WorldToViewportPoint(targetPos)
    if not onScreen then return end
    
    local currentCFrame = Camera.CFrame
    local directionToTarget = (targetPos - currentCFrame.Position).Unit
    local targetCFrame = CFrame.lookAt(currentCFrame.Position, currentCFrame.Position + directionToTarget)
    
    local smoothCFrame = currentCFrame:Lerp(targetCFrame, Settings.Aimbot.Smoothness)
    Camera.CFrame = smoothCFrame
end

