                        for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
                            if remote:IsA("RemoteEvent") and (remote.Name:lower():find("pick") or remote.Name:lower():find("grab")) then
                                remote:FireServer(item)
                                break
                            end
                        end
                    end
                    task.wait(0.2)
                end
            end
        end
    end
end

-- Aimbot
local function DoAimbot()
    if not Settings.Aimbot.Enabled then return end
    
    local murderer = GetMurderer()
    if not murderer then return end
    
    local char = murderer.Character
    if not char then return end
    
    local head = char:FindFirstChild("Head")
    local aimPart = head or char:FindFirstChild("HumanoidRootPart")
    if not aimPart then return end
    
    local targetPos = aimPart.Position
    local screenPos, onScreen = Camera:WorldToViewportPoint(targetPos)
    if not onScreen then return end
    
    local currentCF = Camera.CFrame
    local targetDir = (targetPos - currentCF.Position).Unit
    local targetCF = CFrame.lookAt(currentCF.Position, currentCF.Position + targetDir)
    
    local smoothCF = currentCF:Lerp(targetCF, Settings.Aimbot.Smoothness)
    Camera.CFrame = smoothCF
end

-- ESP Drawing
local boxes = {}
local texts = {}
local traces = {}

local function WorldToScreen(pos)
    local vec, onScreen = Camera:WorldToViewportPoint(pos)
    return Vector2.new(vec.X, vec.Y), onScreen
end

local function CreateESP(player)
    if player == LocalPlayer then return end
    
    local box = Drawing.new("Square")
    box.Thickness = Settings.ESP.BoxThickness
    box.Visible = false
    box.Filled = false
    boxes[player] = box
    
    local text = Drawing.new("Text")
    text.Size = Settings.ESP.TextSize
    text.Center = true
    text.Visible = false
    text.Outline = true
    text.OutlineColor = Color3.new(0, 0, 0)
    texts[player] = text
    
    local trace = Drawing.new("Line")
    trace.Thickness = Settings.Trace.Thickness
    trace.Visible = false
    traces[player] = trace
end

local function RemoveESP(player)
    if boxes[player] then
        boxes[player]:Remove()
        boxes[player] = nil
    end
    if texts[player] then
        texts[player]:Remove()
        texts[player] = nil
    end
    if traces[player] then
        traces[player]:Remove()
        traces[player] = nil
    end
end

local function UpdateESP()
    if not Settings.ESP.Enabled then
        for _, box in pairs(boxes) do if box then box.Visible = false end end
        for _, text in pairs(texts) do if text then text.Visible = false end end
        for _, trace in pairs(traces) do if trace then trace.Visible = false end end
        return
    end
    
    UpdateAllRoles()
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if not boxes[player] then
                CreateESP(player)
            end
            
            CheckAntiFling(player)
            
            local box = boxes[player]
            local text = texts[player]
            local trace = traces[player]
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            
            if box and text and trace and root and char then
                local role = PlayerRoles[player] or "Innocent"
                local color = RoleColors[role]
                local symbol = role == "Murderer" and "🔪 " or (role == "Sheriff" and "⭐ " or "👤 ")
                local dist = (Camera.CFrame.Position - root.Position).Magnitude
                
                box.Color = color
                text.Color = color
                text.Text = symbol .. player.Name .. " [" .. role .. "] " .. math.floor(dist) .. "m"
                
                if dist <= Settings.ESP.MaxDistance then
                    local hum = char:FindFirstChild("Humanoid")
                    if hum and hum.Health > 0 then
                        local head = char:FindFirstChild("Head")
                        if head then
                            local headScreen, headOn = WorldToScreen(head.Position)
                            local footScreen, footOn = WorldToScreen(root.Position - Vector3.new(0, 3, 0))
                            
                            if headOn and footOn then
                                local height = footScreen.Y - headScreen.Y
                                local width = height * 0.5
                                
                                box.Size = Vector2.new(width, height)
                                box.Position = Vector2.new(headScreen.X - width/2, headScreen.Y)
                                box.Visible = true
                                
                                text.Position = Vector2.new(headScreen.X, headScreen.Y - 18)
                                text.Visible = true
                            else
                                box.Visible = false
                                text.Visible = false
                            end
                        end
                    else
                        box.Visible = false
                        text.Visible = false
                    end
                else
                    box.Visible = false
                    text.Visible = false
                end
                
                -- Trace line
                if Settings.Trace.Enabled then
                    local screenPos, onScreen = WorldToScreen(root.Position)
                    if onScreen then
                        local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                        trace.From = center
                        trace.To = Vector2.new(screenPos.X, screenPos.Y)
                        trace.Color = color
                        trace.Visible = true
                    else
                        trace.Visible = false
                    end
                else
                    trace.Visible = false
                end
            else
                if box then box.Visible = false end
                if text then text.Visible = false end
                if trace then trace.Visible = false end
            end
        end
    end
end

