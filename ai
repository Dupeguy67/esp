local Mouse = LocalPlayer:GetMouse()

-- ESP ve Aimbot Durumu
local ESPState = {
    Enabled = true,
    AimbotEnabled = true,
    MaxDistance = 500,
    Smoothness = 0.3
}

-- Role renkleri
local RoleColors = {
    Murderer = Color3.new(1, 0, 0),      -- Kirmizi
    Sheriff = Color3.new(0, 0.4, 1),     -- Mavi
    Innocent = Color3.new(0, 1, 0)       -- Yesil
}

-- Player rolleri
local PlayerRoles = {}

-- Rol tespit fonksiyonlari
local function GetPlayerRole(Player)
    if Player == LocalPlayer then return nil end
    
    local Character = Player.Character
    if not Character then return "Innocent" end
    
    -- 1. Kontrol: Elindaki esya (bicak = murderer, tabanca = sheriff)
    local CurrentTool = Character:FindFirstChildOfClass("Tool")
    if CurrentTool then
        local ToolName = CurrentTool.Name:lower()
        if ToolName:find("knife") or ToolName:find("dagger") or ToolName:find("blade") then
            return "Murderer"
        elseif ToolName:find("gun") or ToolName:find("pistol") or ToolName:find("revolver") then
            return "Sheriff"
        end
    end
    
    -- 2. Kontrol: Backpack icindeki esyalar
    local Backpack = Player:FindFirstChild("Backpack")
    if Backpack then
        for _, tool in ipairs(Backpack:GetChildren()) do
            if tool:IsA("Tool") then
                local ToolName = tool.Name:lower()
                if ToolName:find("knife") or ToolName:find("dagger") then
                    return "Murderer"
                elseif ToolName:find("gun") or ToolName:find("pistol") then
                    return "Sheriff"
                end
            end
        end
    end
    
    -- 3. Kontrol: Player gui veya NameDisplay rengi
    local PlayerGui = Player:FindFirstChild("PlayerGui")
    if PlayerGui then
        local NameTag = PlayerGui:FindFirstChild("NameTag")
        if NameTag and NameTag:IsA("BillboardGui") then
            local TextLabel = NameTag:FindFirstChild("TextLabel")
            if TextLabel and TextLabel:IsA("TextLabel") then
                local text = TextLabel.Text:lower()
                if text:find("murderer") then return "Murderer"
                elseif text:find("sheriff") then return "Sheriff" end
            end
        end
    end
    
    -- 4. Kontrol: Karakterin ustundeki mesh veya aksesuar renkleri
    local Head = Character:FindFirstChild("Head")
    if Head then
        -- Kirmizi efekt = murderer
        local HeadColor = Head:FindFirstChild("ColorCorrection") or Head:FindFirstChild("BillboardGui")
        if HeadColor then
            -- Basit kontrol: murderer genelde kirmizi efekte sahip
        end
    end
    
    -- 5. Kontrol: Remote event dinleme (bazi oyunlarda rol bilgisi gonderilir)
    local Remote = ReplicatedStorage:FindFirstChild("RoleData") or ReplicatedStorage:FindFirstChild("PlayerRole")
    if Remote then
        -- Remote'dan gelen veriler dinlenebilir (orijinal scriptte)
    end
    
    return "Innocent"  -- Varsayilan
end

-- Tum oyuncularin rollerini guncelle
local function UpdateAllRoles()
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer then
            local newRole = GetPlayerRole(Player)
            if PlayerRoles[Player] ~= newRole then
                PlayerRoles[Player] = newRole
            end
        end
    end
end

-- Murderer'i bul (aimbot icin)
local function GetMurderer()
    for Player, role in pairs(PlayerRoles) do
        if role == "Murderer" then
            return Player
        end
    end
    return nil
end

-- Sheriff'i bul
local function GetSheriff()
    for Player, role in pairs(PlayerRoles) do
        if role == "Sheriff" then
            return Player
        end
    end
    return nil
end

-- Aimbot: Hedefe nişan al (sadece murderer)
local function AimAtPosition(TargetPos)
    if not TargetPos then return end
    local CurrentCFrame = Camera.CFrame
    local TargetDirection = (TargetPos - CurrentCFrame.Position).Unit
    local TargetCFrame = CFrame.lookAt(CurrentCFrame.Position, CurrentCFrame.Position + TargetDirection)
    Camera.CFrame = Camera.CFrame:Lerp(TargetCFrame, ESPState.Smoothness)
end

local function GetMurdererHeadPosition()
    local Murderer = GetMurderer()
    if not Murderer then return nil end
    local Character = Murderer.Character
    if not Character then return nil end
    local Head = Character:FindFirstChild("Head")
    if not Head then return nil end
    return Head.Position
end

-- ESP Cizim Nesneleri
local Boxes = {}
local TextLabels = {}

local function WorldToScreen(WorldPosition)
    local Vector, OnScreen = Camera:WorldToViewportPoint(WorldPosition)
    return Vector2.new(Vector.X, Vector.Y), OnScreen
end

local function CreateESPForPlayer(Player)
    if Player == LocalPlayer then return end
    
    local Character = Player.Character
    if not Character or not Character:FindFirstChild("HumanoidRootPart") then return end
    
    local Box = Drawing.new("Square")
    Box.Thickness = 1.5
    Box.Visible = false
    Box.Filled = false
    
    local Text = Drawing.new("Text")
    Text.Size = 13
    Text.Center = true
    Text.Visible = false
    
    Boxes[Player] = Box
    TextLabels[Player] = Text
end

local function RemoveESP(Player)
    if Boxes[Player] then
        Boxes[Player]:Remove()
        Boxes[Player] = nil
    end
    if TextLabels[Player] then
        TextLabels[Player]:Remove()
        TextLabels[Player] = nil
    end
end

local function UpdateESP()
    if not ESPState.Enabled then
        for _, box in pairs(Boxes) do
            if box then box.Visible = false end
        end
        for _, text in pairs(TextLabels) do
            if text then text.Visible = false end
        end
        return
    end
    
    UpdateAllRoles()
    
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer then
            if not Boxes[Player] then
                CreateESPForPlayer(Player)
            end
            
            local Box = Boxes[Player]
            local Text = TextLabels[Player]
            local Character = Player.Character
            local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
            
            if Box and Text and RootPart and Character then
                local role = PlayerRoles[Player] or "Innocent"
                local BoxColor = RoleColors[role] or RoleColors.Innocent
                local TextColor = BoxColor
                
                local RootPos = RootPart.Position
                local Distance = (Camera.CFrame.Position - RootPos).Magnitude
                
                -- Role sembolu ve mesafe
                local roleSymbol = ""
                if role == "Murderer" then roleSymbol = "🔪 "
                elseif role == "Sheriff" then roleSymbol = "⭐ "
                else roleSymbol = "👤 " end
                
                Box.Color = BoxColor
                Text.Color = TextColor
                Text.Text = roleSymbol .. Player.Name .. " [" .. role .. "] " .. math.floor(Distance) .. "m"
                
                if Distance <= ESPState.MaxDistance then
                    local Humanoid = Character:FindFirstChild("Humanoid")
                    if Humanoid and Humanoid.Health > 0 then
                        local Head = Character:FindFirstChild("Head")
                        if Head then
                            local HeadPos = Head.Position
                            local FootPos = RootPos - Vector3.new(0, 3, 0)
                            
                            local HeadScreen, HeadOnScreen = WorldToScreen(HeadPos)
                            local FootScreen, FootOnScreen = WorldToScreen(FootPos)
                            
                            if HeadOnScreen and FootOnScreen then
                                local Height = FootScreen.Y - HeadScreen.Y
                                local Width = Height * 0.5
                                
                                Box.Size = Vector2.new(Width, Height)
                                Box.Position = Vector2.new(HeadScreen.X - Width/2, HeadScreen.Y)
                                Box.Visible = true
                                
                                Text.Position = Vector2.new(HeadScreen.X, HeadScreen.Y - 18)
                                Text.Visible = true
                            else
                                Box.Visible = false
                                Text.Visible = false
                            end
                        end
                    else
                        Box.Visible = false
                        Text.Visible = false
                    end
                else
                    Box.Visible = false
                    Text.Visible = false
                end
            elseif Box and Text then
                Box.Visible = false
                Text.Visible = false
            end
        end
    end
end

-- Aimbot dongusu
local function AutoAimbot()
    if not ESPState.AimbotEnabled then return end
    local HeadPos = GetMurdererHeadPosition()
    if HeadPos then
        local ScreenPos, OnScreen = Camera:WorldToViewportPoint(HeadPos)
        if OnScreen then
            local TargetDirection = (HeadPos - Camera.CFrame.Position).Unit
            local TargetCFrame = CFrame.lookAt(Camera.CFrame.Position, Camera.CFrame.Position + TargetDirection)
            Camera.CFrame = Camera.CFrame:Lerp(TargetCFrame, ESPState.Smoothness)
        end
    end
end

