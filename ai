local function RemoveESP(player)
    local esp = ESPBillboards[player]
    if esp and esp.billboard then
        esp.billboard:Destroy()
    end
    ESPBillboards[player] = nil
end

local function UpdateESPColors()
    for player, esp in pairs(ESPBillboards) do
        local role = PlayerRoles[player] or "Innocent"
        local color = RoleColors[role]
        local symbol = role == "Murderer" and "🔪 " or (role == "Sheriff" and "⭐ " or "👤 ")
        
        if esp and esp.label then
            esp.label.Text = symbol .. player.Name .. " [" .. role .. "]"
            esp.label.TextColor3 = color
        end
    end
end

-- Role Detection
local function GetPlayerRole(player)
    if player == LocalPlayer then return nil end
    
    local character = player.Character
    if not character then return "Innocent" end
    
    -- Check held tool
    local tool = character:FindFirstChildOfClass("Tool")
    if tool then
        local name = tool.Name:lower()
        if name:find("knife") or name:find("dagger") or name:find("blade") then
            return "Murderer"
        elseif name:find("gun") or name:find("pistol") or name:find("revolver") then
            return "Sheriff"
        end
    end
    
    return "Innocent"
end

local function UpdateAllRoles()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            PlayerRoles[player] = GetPlayerRole(player)
        end
    end
    UpdateESPColors()
end

local function GetMurderer()
    for player, role in pairs(PlayerRoles) do
        if role == "Murderer" then
            local char = player.Character
            if char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                return player
            end
        end
    end
    return nil
end

local function GetSheriff()
    for player, role in pairs(PlayerRoles) do
        if role == "Sheriff" then
            local char = player.Character
            if char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                return player
            end
        end
    end
    return nil
end

-- Speed Hack
local originalSpeed = 16

local function SetSpeed(enabled, value)
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    if not hum then return end
    
    if enabled then
        originalSpeed = hum.WalkSpeed
        hum.WalkSpeed = value
    else
        hum.WalkSpeed = originalSpeed
    end
end

-- Fly Hack
local flying = false
local flyBodyVel = nil

local function StopFly()
    if flyBodyVel then
        flyBodyVel:Destroy()
        flyBodyVel = nil
    end
    flying = false
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChild("Humanoid")
        if hum then hum.PlatformStand = false end
    end
end

local function StartFly()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end
    
    StopFly()
    flying = true
    
    flyBodyVel = Instance.new("BodyVelocity")
    flyBodyVel.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    flyBodyVel.Velocity = Vector3.new(0, 0, 0)
    flyBodyVel.Parent = root
    hum.PlatformStand = true
    
    task.spawn(function()
        while flying and root and root.Parent do
            local moveDir = Vector3.new()
            local camCF = Camera.CFrame
            
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + camCF.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - camCF.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - camCF.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + camCF.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir = moveDir - Vector3.new(0, 1, 0) end
            
            if moveDir.Magnitude > 0 then
                moveDir = moveDir.Unit * Settings.FlySpeed
            end
            
            if flyBodyVel then
                flyBodyVel.Velocity = moveDir
            end
            task.wait()
        end
    end)
end

-- Invisible Hack
local function SetInvisible(enabled)
    local char = LocalPlayer.Character
    if not char then return end
    
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Transparency = enabled and 1 or 0
            if enabled then part.Material = Enum.Material.ForceField end
        elseif part:IsA("BillboardGui") then
            part.Enabled = not enabled
        end
    end
    local hum = char:FindFirstChild("Humanoid")
    if hum then
        hum.NameDisplayDistance = enabled and 0 or 100
    end
end

-- Auto Pickup Gun
local function AutoPickupGun()
    if not Settings.AutoPickup then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local charPos = root.Position
    
    for _, item in pairs(Workspace:GetDescendants()) do
        if item:IsA("Tool") and item.Parent ~= char and item.Parent ~= LocalPlayer.Backpack then
            local name = item.Name:lower()
            local isGun = name:find("gun") or name:find("pistol") or name:find("revolver") or name:find("sheriff")
            
            if isGun then
                local dist = (charPos - item.Position).Magnitude
                if dist <= 20 then
                    local prompt = item:FindFirstChildOfClass("ProximityPrompt")
                    if prompt then
                        prompt:Hold()
                        task.wait(0.05)
                        prompt:Release()
                    end
                    task.wait(0.3)
                end
            end
        end
    end
end

-- Aimbot (simple)
local function DoAimbot()
    if not Settings.Aimbot then return end
    
    local murderer = GetMurderer()
    if not murderer then return end
    
    local char = murderer.Character
    if not char then return end
    
    local head = char:FindFirstChild("Head")
    local aimPart = head or char:FindFirstChild("HumanoidRootPart")
    if not aimPart then return end
    
    local targetPos = aimPart.Position
    local currentCF = Camera.CFrame
    local targetDir = (targetPos - currentCF.Position).Unit
    local targetCF = CFrame.lookAt(currentCF.Position, currentCF.Position + targetDir)
    
    Camera.CFrame = currentCF:Lerp(targetCF, 0.2)
end

